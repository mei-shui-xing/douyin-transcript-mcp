{
  "name": "douyin-transcript-mcp",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first, read-only Douyin speech transcription MCP powered by Qwen3-ASR.",
  "keywords": [
    "mcp",
    "douyin",
    "qwen3-asr",
    "speech-to-text",
    "local-ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:public": "node scripts/audit-public-snapshot.mjs",
    "test": "npm run audit:public && npm run typecheck && npm run build && node dist/test-fixtures.js",
    "start": "node dist/index.js --http",
    "start:http": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
